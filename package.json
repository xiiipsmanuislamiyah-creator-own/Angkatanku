{
  "name": "angkatanku",
  "private": true,
  "version": "2.0.0-security.1",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "node scripts/clean-build.mjs && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/server.mjs",
    "start": "node scripts/start-production.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rules": "node --import tsx scripts/test-emulator.ts",
    "test:e2e": "playwright test",
    "migrate:security": "node --import tsx scripts/migrate-security.ts",
    "media:gc": "node --import tsx scripts/media-gc.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-type": "^21.0.0",
    "firebase-admin": "^14.5.0",
    "html2canvas": "^1.4.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-zoom-pan-pinch": "^4.0.4",
    "sharp": "^0.35.5",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase": "^12.16.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
