FIREBASE_PROJECT_ID=demo-angkatanku
FIREBASE_DATABASE_ID=(default)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Production: unset emulator, use workload identity/ADC with least privilege.
GOOGLE_APPLICATION_CREDENTIALS=
APP_ORIGINS=http://localhost:3000
PORT=3000
# Set only to verified ingress proxy CIDRs, never trust all forwarded headers.
TRUSTED_PROXY_CIDRS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Public browser Maps key: enforce domain and API restrictions.
VITE_GOOGLE_MAPS_API_KEY=
JAVA_BIN=java
FIRESTORE_EMULATOR_JAR=
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
