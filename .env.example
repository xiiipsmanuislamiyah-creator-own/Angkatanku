FIREBASE_PROJECT_ID=demo-angkatanku
FIREBASE_DATABASE_ID=(default)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Production: unset emulator, use workload identity/ADC with least privilege.
GOOGLE_APPLICATION_CREDENTIALS=
APP_ORIGINS=http://localhost:3000
PORT=3000
# Set only to verified ingress proxy CIDRs, never trust all forwarded headers.
TRUSTED_PROXY_CIDRS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Public browser Maps key: enforce domain and API restrictions.
VITE_GOOGLE_MAPS_API_KEY=
JAVA_BIN=java
FIRESTORE_EMULATOR_JAR=
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Vercel: server-only JSON secret, project must match FIREBASE_PROJECT_ID.
# Use a rotated key, never the exposed original or VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_PREFER_REST=false
# Signed private uploads: enabled automatically on Vercel, optional elsewhere.
DIRECT_MEDIA_UPLOAD=false
